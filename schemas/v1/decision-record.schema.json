{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/c82ymk5ykr-wq/marino-cio-office/main/schemas/v1/decision-record.schema.json",
  "title": "Marino CIO Office decision record",
  "description": "Public contract separating research disposition from deployment action.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision_id",
    "idea_id",
    "recorded_at",
    "research_disposition",
    "deployment",
    "rationale",
    "historian_note",
    "skeptic_countercase",
    "alternatives_considered",
    "invalidation_conditions",
    "review_by",
    "evidence_ids"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "decision_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "idea_id": {
      "type": "string",
      "minLength": 1
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "research_disposition": {
      "type": "string",
      "enum": [
        "advance",
        "monitor",
        "hold",
        "reject"
      ]
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "readiness",
        "action",
        "timing_and_confirmation",
        "size_band",
        "scaling_plan"
      ],
      "properties": {
        "readiness": {
          "type": "string",
          "enum": [
            "not_ready",
            "ready",
            "blocked"
          ]
        },
        "action": {
          "type": "string",
          "enum": [
            "no_action",
            "initiate",
            "add",
            "trim",
            "exit"
          ]
        },
        "timing_and_confirmation": {
          "type": "string",
          "minLength": 1
        },
        "size_band": {
          "type": "string",
          "minLength": 1,
          "description": "A policy band only; never real client or account data."
        },
        "scaling_plan": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "historian_note": {
      "type": "string",
      "minLength": 1
    },
    "skeptic_countercase": {
      "type": "string",
      "minLength": 1
    },
    "alternatives_considered": {
      "$ref": "#/$defs/non_empty_strings"
    },
    "invalidation_conditions": {
      "$ref": "#/$defs/non_empty_strings"
    },
    "review_by": {
      "type": "string",
      "format": "date-time"
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "non_empty_strings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}
