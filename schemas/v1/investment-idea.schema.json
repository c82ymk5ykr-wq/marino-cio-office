{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/c82ymk5ykr-wq/marino-cio-office/main/schemas/v1/investment-idea.schema.json",
  "title": "Marino CIO Office investment idea",
  "description": "Public contract for a research idea without private position or account data.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "idea_id",
    "first_seen_at",
    "last_seen_at",
    "board",
    "research_state",
    "asset",
    "thesis",
    "regime_fit",
    "catalysts",
    "risks",
    "invalidation_conditions",
    "time_horizon",
    "timing_notes",
    "confidence",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1.0.0",
        "1.1.0"
      ],
      "description": "Version 1.1.0 adds explicit, backward-compatible idea-lineage metadata."
    },
    "idea_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "first_seen_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_seen_at": {
      "type": "string",
      "format": "date-time"
    },
    "board": {
      "type": "string",
      "enum": [
        "FRESH_IDEA_DISCOVERY",
        "CORE_CONVICTION_MONITOR",
        "REJECTED_IDEA_BOARD"
      ]
    },
    "research_state": {
      "type": "string",
      "enum": [
        "candidate",
        "advance",
        "monitor",
        "hold",
        "reject",
        "archive"
      ]
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "symbol",
        "name",
        "asset_type"
      ],
      "properties": {
        "symbol": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "asset_type": {
          "type": "string",
          "enum": [
            "equity",
            "etf",
            "closed_end_fund",
            "fixed_income",
            "commodity",
            "currency",
            "other"
          ]
        }
      }
    },
    "thesis": {
      "type": "string",
      "minLength": 1
    },
    "regime_fit": {
      "type": "string",
      "minLength": 1
    },
    "catalysts": {
      "$ref": "#/$defs/non_empty_strings"
    },
    "risks": {
      "$ref": "#/$defs/non_empty_strings"
    },
    "invalidation_conditions": {
      "$ref": "#/$defs/non_empty_strings"
    },
    "time_horizon": {
      "type": "string",
      "minLength": 1
    },
    "timing_notes": {
      "type": "string",
      "minLength": 1
    },
    "confidence": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "provenance",
          "claim"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "provenance": {
            "type": "string",
            "enum": [
              "PASTED",
              "INLINE",
              "CIO_LEVEL_INFERENCE"
            ]
          },
          "claim": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "classification",
        "changed_dimensions"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "verified",
            "unverified"
          ]
        },
        "classification": {
          "type": "string",
          "enum": [
            "new",
            "repeat_unchanged",
            "materially_updated",
            "reintroduced",
            "stale_repeat",
            "unverified"
          ]
        },
        "last_material_change_at": {
          "type": "string",
          "format": "date-time"
        },
        "repeat_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Cumulative verified appearances after the first, including the current repeat."
        },
        "changed_dimensions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "thesis",
              "evidence",
              "catalysts",
              "risks",
              "invalidation_conditions",
              "research_state"
            ]
          },
          "uniqueItems": true
        },
        "verification_note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "repeat_reason": {
      "type": "string",
      "minLength": 1,
      "description": "Required for every verified repeat. It explains decision usefulness but does not by itself prove freshness or material change."
    }
  },
  "$defs": {
    "non_empty_strings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "1.0.0"
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "not": {
          "required": [
            "lineage"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "1.1.0"
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "required": [
          "lineage"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "lineage": {
            "properties": {
              "status": {
                "const": "verified"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "lineage"
        ]
      },
      "then": {
        "properties": {
          "lineage": {
            "required": [
              "last_material_change_at",
              "repeat_count"
            ],
            "properties": {
              "classification": {
                "not": {
                  "const": "unverified"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lineage": {
            "properties": {
              "status": {
                "const": "unverified"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "lineage"
        ]
      },
      "then": {
        "properties": {
          "lineage": {
            "required": [
              "verification_note"
            ],
            "properties": {
              "classification": {
                "const": "unverified"
              },
              "changed_dimensions": {
                "maxItems": 0
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "last_material_change_at"
                  ]
                },
                {
                  "required": [
                    "repeat_count"
                  ]
                }
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lineage": {
            "properties": {
              "classification": {
                "const": "new"
              }
            },
            "required": [
              "classification"
            ]
          }
        },
        "required": [
          "lineage"
        ]
      },
      "then": {
        "properties": {
          "lineage": {
            "properties": {
              "repeat_count": {
                "const": 0
              },
              "changed_dimensions": {
                "maxItems": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lineage": {
            "properties": {
              "classification": {
                "enum": [
                  "repeat_unchanged",
                  "stale_repeat"
                ]
              }
            },
            "required": [
              "classification"
            ]
          }
        },
        "required": [
          "lineage"
        ]
      },
      "then": {
        "required": [
          "repeat_reason"
        ],
        "properties": {
          "lineage": {
            "properties": {
              "repeat_count": {
                "minimum": 1
              },
              "changed_dimensions": {
                "maxItems": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lineage": {
            "properties": {
              "classification": {
                "const": "materially_updated"
              }
            },
            "required": [
              "classification"
            ]
          }
        },
        "required": [
          "lineage"
        ]
      },
      "then": {
        "required": [
          "repeat_reason"
        ],
        "properties": {
          "lineage": {
            "properties": {
              "repeat_count": {
                "minimum": 1
              },
              "changed_dimensions": {
                "minItems": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lineage": {
            "properties": {
              "classification": {
                "const": "reintroduced"
              }
            },
            "required": [
              "classification"
            ]
          }
        },
        "required": [
          "lineage"
        ]
      },
      "then": {
        "required": [
          "repeat_reason"
        ],
        "properties": {
          "lineage": {
            "properties": {
              "repeat_count": {
                "minimum": 1
              },
              "changed_dimensions": {
                "contains": {
                  "const": "research_state"
                }
              }
            }
          }
        }
      }
    }
  ]
}
