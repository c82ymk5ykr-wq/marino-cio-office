{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/c82ymk5ykr-wq/marino-cio-office/main/schemas/v1/investment-idea.schema.json",
  "title": "Marino CIO Office investment idea",
  "description": "Public contract for a research idea without private position or account data.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "idea_id",
    "first_seen_at",
    "last_seen_at",
    "board",
    "research_state",
    "asset",
    "thesis",
    "regime_fit",
    "catalysts",
    "risks",
    "invalidation_conditions",
    "time_horizon",
    "timing_notes",
    "confidence",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "idea_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "first_seen_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_seen_at": {
      "type": "string",
      "format": "date-time"
    },
    "board": {
      "type": "string",
      "enum": [
        "FRESH_IDEA_DISCOVERY",
        "CORE_CONVICTION_MONITOR",
        "REJECTED_IDEA_BOARD"
      ]
    },
    "research_state": {
      "type": "string",
      "enum": [
        "candidate",
        "advance",
        "monitor",
        "hold",
        "reject",
        "archive"
      ]
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "symbol",
        "name",
        "asset_type"
      ],
      "properties": {
        "symbol": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "asset_type": {
          "type": "string",
          "enum": [
            "equity",
            "etf",
            "closed_end_fund",
            "fixed_income",
            "commodity",
            "currency",
            "other"
          ]
        }
      }
    },
    "thesis": {
      "type": "string",
      "minLength": 1
    },
    "regime_fit": {
      "type": "string",
      "minLength": 1
    },
    "catalysts": {
      "$ref": "#/$defs/non_empty_strings"
    },
    "risks": {
      "$ref": "#/$defs/non_empty_strings"
    },
    "invalidation_conditions": {
      "$ref": "#/$defs/non_empty_strings"
    },
    "time_horizon": {
      "type": "string",
      "minLength": 1
    },
    "timing_notes": {
      "type": "string",
      "minLength": 1
    },
    "confidence": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "provenance",
          "claim"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "provenance": {
            "type": "string",
            "enum": [
              "PASTED",
              "INLINE",
              "CIO_LEVEL_INFERENCE"
            ]
          },
          "claim": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "repeat_reason": {
      "type": "string",
      "minLength": 1,
      "description": "Required by operating policy when the idea materially repeats."
    }
  },
  "$defs": {
    "non_empty_strings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}
