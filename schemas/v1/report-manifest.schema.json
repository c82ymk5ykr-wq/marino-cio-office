{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/c82ymk5ykr-wq/marino-cio-office/main/schemas/v1/report-manifest.schema.json",
  "title": "Marino CIO Office report manifest",
  "description": "Public contract for report control, quality, lineage, and persistence metadata.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "report_type",
    "generated_at",
    "data_as_of",
    "status",
    "status_reason",
    "coverage",
    "freshness",
    "sources",
    "quality_flags",
    "idea_ids",
    "decision_ids",
    "artifact"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "report_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "report_type": {
      "type": "string",
      "enum": [
        "daily_decision_report",
        "ad_hoc_decision_report",
        "system_quality_report"
      ]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "data_as_of": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "complete",
        "provisional",
        "degraded",
        "failed"
      ]
    },
    "status_reason": {
      "type": "string",
      "minLength": 1
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "universe",
        "expected",
        "observed",
        "percent",
        "gaps"
      ],
      "properties": {
        "universe": {
          "type": "string",
          "minLength": 1
        },
        "expected": {
          "type": "integer",
          "minimum": 0
        },
        "observed": {
          "type": "integer",
          "minimum": 0
        },
        "percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "oldest_material_source_as_of",
        "threshold_hours"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "fresh",
            "stale",
            "unknown"
          ]
        },
        "oldest_material_source_as_of": {
          "type": "string",
          "format": "date-time"
        },
        "threshold_hours": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "quality_flags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "idea_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "decision_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "note"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "persisted",
            "failed",
            "not_attempted"
          ]
        },
        "durable_reference": {
          "type": "string",
          "minLength": 1,
          "description": "Opaque private reference; never a credential or temporary URL."
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "category",
        "provenance",
        "data_as_of",
        "retrieved_at",
        "status",
        "note"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "enum": [
            "market",
            "macro",
            "fundamental",
            "technical",
            "positioning",
            "news",
            "risk",
            "internal"
          ]
        },
        "provenance": {
          "type": "string",
          "enum": [
            "PASTED",
            "INLINE",
            "CIO_LEVEL_INFERENCE"
          ]
        },
        "data_as_of": {
          "type": "string",
          "format": "date-time"
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "type": "string",
          "enum": [
            "available",
            "fallback",
            "stale",
            "unavailable"
          ]
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "complete"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "coverage": {
            "properties": {
              "gaps": {
                "maxItems": 0
              }
            }
          },
          "freshness": {
            "properties": {
              "status": {
                "const": "fresh"
              }
            }
          },
          "artifact": {
            "properties": {
              "status": {
                "const": "persisted"
              }
            }
          }
        }
      }
    }
  ]
}
