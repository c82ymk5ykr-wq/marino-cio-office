{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/c82ymk5ykr-wq/marino-cio-office/main/schemas/v1/report-manifest.schema.json",
  "title": "Marino CIO Office report manifest",
  "description": "Public contract for report control, quality, lineage, gate evidence, and persistence metadata.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "report_type",
    "generated_at",
    "data_as_of",
    "status",
    "status_reason",
    "coverage",
    "freshness",
    "sources",
    "quality_flags",
    "idea_ids",
    "decision_ids",
    "artifact"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1.0.0",
        "1.1.0"
      ],
      "description": "Version 1.1.0 adds backward-compatible, deterministic report-acceptance evidence."
    },
    "report_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "report_type": {
      "type": "string",
      "enum": [
        "daily_decision_report",
        "ad_hoc_decision_report",
        "system_quality_report"
      ]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "data_as_of": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "complete",
        "provisional",
        "degraded",
        "failed"
      ]
    },
    "status_reason": {
      "type": "string",
      "minLength": 1
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "universe",
        "expected",
        "observed",
        "percent",
        "gaps"
      ],
      "properties": {
        "universe": {
          "type": "string",
          "minLength": 1
        },
        "expected": {
          "type": "integer",
          "minimum": 0
        },
        "observed": {
          "type": "integer",
          "minimum": 0
        },
        "percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "freshness": {
      "type": "object"
    },
    "sources": {
      "type": "array",
      "minItems": 1
    },
    "quality_flags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "idea_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "decision_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "artifact": {
      "type": "object"
    },
    "gate_inputs": {
      "$ref": "#/$defs/gate_inputs_v1_1"
    }
  },
  "$defs": {
    "freshness_v1_0": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "oldest_material_source_as_of",
        "threshold_hours"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "fresh",
            "stale",
            "unknown"
          ]
        },
        "oldest_material_source_as_of": {
          "type": "string",
          "format": "date-time"
        },
        "threshold_hours": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "freshness_v1_1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "threshold_hours"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "fresh",
            "stale",
            "unknown"
          ]
        },
        "oldest_material_source_as_of": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z(?![\\s\\S])"
        },
        "threshold_hours": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "fresh",
                  "stale"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "oldest_material_source_as_of"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "unknown"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "not": {
              "required": [
                "oldest_material_source_as_of"
              ]
            }
          }
        }
      ]
    },
    "source_v1_0": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "category",
        "provenance",
        "data_as_of",
        "retrieved_at",
        "status",
        "note"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "$ref": "#/$defs/source_category"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "data_as_of": {
          "type": "string",
          "format": "date-time"
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "$ref": "#/$defs/source_status"
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source_v1_1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "category",
        "provenance",
        "checked_at",
        "status",
        "note"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "category": {
          "$ref": "#/$defs/source_category"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "data_as_of": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z(?![\\s\\S])"
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z(?![\\s\\S])"
        },
        "checked_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z(?![\\s\\S])"
        },
        "status": {
          "$ref": "#/$defs/source_status"
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "available",
                  "fallback",
                  "stale"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "data_as_of",
              "retrieved_at"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "unavailable"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "data_as_of"
                  ]
                },
                {
                  "required": [
                    "retrieved_at"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "source_category": {
      "type": "string",
      "enum": [
        "market",
        "macro",
        "fundamental",
        "technical",
        "positioning",
        "news",
        "risk",
        "internal"
      ]
    },
    "provenance": {
      "type": "string",
      "enum": [
        "PASTED",
        "INLINE",
        "CIO_LEVEL_INFERENCE"
      ]
    },
    "source_status": {
      "type": "string",
      "enum": [
        "available",
        "fallback",
        "stale",
        "unavailable"
      ]
    },
    "artifact_v1_0": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "note"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/artifact_status"
        },
        "durable_reference": {
          "type": "string",
          "minLength": 1,
          "description": "Opaque private reference; never a credential or temporary URL."
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "artifact_v1_1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "note"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/artifact_status"
        },
        "durable_reference": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{7,127}(?![\\s\\S])",
          "description": "Non-sensitive opaque receipt token containing no URI scheme, slash, backslash, whitespace, or storage location."
        },
        "persisted_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z(?![\\s\\S])"
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "persisted"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "durable_reference",
              "persisted_at"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "durable_reference"
                  ]
                },
                {
                  "required": [
                    "persisted_at"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "artifact_status": {
      "type": "string",
      "enum": [
        "persisted",
        "failed",
        "not_attempted"
      ]
    },
    "gate_inputs_v1_1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reliable_product",
        "completion_profile_id",
        "denominator_known",
        "required_period",
        "required_period_lag_known",
        "required_reviews_complete",
        "source_roles"
      ],
      "properties": {
        "reliable_product": {
          "type": "boolean"
        },
        "completion_profile_id": {
          "type": "string",
          "enum": [
            "broad_equity_daily",
            "curated_etf_daily",
            "declared_bounded_set"
          ]
        },
        "denominator_known": {
          "type": "boolean"
        },
        "membership_as_of": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z(?![\\s\\S])"
        },
        "required_period": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "required_period_lag": {
          "type": "integer",
          "minimum": 0
        },
        "required_period_lag_known": {
          "type": "boolean"
        },
        "gap_count": {
          "type": "integer",
          "minimum": 0
        },
        "required_reviews_complete": {
          "type": "boolean"
        },
        "source_roles": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/source_role"
          },
          "allOf": [
            {
              "$ref": "#/$defs/contains_membership_role"
            },
            {
              "$ref": "#/$defs/contains_observations_role"
            },
            {
              "$ref": "#/$defs/contains_freshness_role"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "denominator_known": {
                "const": true
              }
            },
            "required": [
              "denominator_known"
            ]
          },
          "then": {
            "required": [
              "membership_as_of",
              "gap_count"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "membership_as_of"
                  ]
                },
                {
                  "required": [
                    "gap_count"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "required_period_lag_known": {
                "const": true
              }
            },
            "required": [
              "required_period_lag_known"
            ]
          },
          "then": {
            "required": [
              "required_period_lag"
            ]
          },
          "else": {
            "not": {
              "required": [
                "required_period_lag"
              ]
            }
          }
        }
      ]
    },
    "source_role": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "state",
        "source_ids",
        "note"
      ],
      "properties": {
        "role": {
          "type": "string",
          "enum": [
            "membership_definition",
            "eligible_observations",
            "freshness_reference"
          ]
        },
        "state": {
          "type": "string",
          "enum": [
            "available",
            "equivalent_fallback",
            "stale",
            "non_equivalent_fallback",
            "unavailable"
          ]
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "contains_membership_role": {
      "contains": {
        "properties": {
          "role": {
            "const": "membership_definition"
          }
        },
        "required": [
          "role"
        ]
      },
      "minContains": 1,
      "maxContains": 1
    },
    "contains_observations_role": {
      "contains": {
        "properties": {
          "role": {
            "const": "eligible_observations"
          }
        },
        "required": [
          "role"
        ]
      },
      "minContains": 1,
      "maxContains": 1
    },
    "contains_freshness_role": {
      "contains": {
        "properties": {
          "role": {
            "const": "freshness_reference"
          }
        },
        "required": [
          "role"
        ]
      },
      "minContains": 1,
      "maxContains": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "1.0.0"
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "not": {
          "required": [
            "gate_inputs"
          ]
        },
        "properties": {
          "freshness": {
            "$ref": "#/$defs/freshness_v1_0"
          },
          "sources": {
            "items": {
              "$ref": "#/$defs/source_v1_0"
            }
          },
          "artifact": {
            "$ref": "#/$defs/artifact_v1_0"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "1.1.0"
          },
          "gate_inputs": {
            "properties": {
              "gap_count": {
                "const": 0
              }
            },
            "required": [
              "gap_count"
            ]
          }
        },
        "required": [
          "schema_version",
          "gate_inputs"
        ]
      },
      "then": {
        "properties": {
          "coverage": {
            "properties": {
              "gaps": {
                "maxItems": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "1.1.0"
          },
          "gate_inputs": {
            "properties": {
              "gap_count": {
                "minimum": 1
              }
            },
            "required": [
              "gap_count"
            ]
          }
        },
        "required": [
          "schema_version",
          "gate_inputs"
        ]
      },
      "then": {
        "properties": {
          "coverage": {
            "properties": {
              "gaps": {
                "minItems": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "1.1.0"
          },
          "gate_inputs": {
            "properties": {
              "denominator_known": {
                "const": false
              }
            },
            "required": [
              "denominator_known"
            ]
          }
        },
        "required": [
          "schema_version",
          "gate_inputs"
        ]
      },
      "then": {
        "properties": {
          "coverage": {
            "properties": {
              "expected": {
                "const": 0
              },
              "observed": {
                "const": 0
              },
              "percent": {
                "const": 0
              },
              "gaps": {
                "maxItems": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "1.1.0"
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "required": [
          "gate_inputs"
        ],
        "properties": {
          "generated_at": {
            "pattern": "Z(?![\\s\\S])"
          },
          "data_as_of": {
            "pattern": "Z(?![\\s\\S])"
          },
          "status_reason": {
            "pattern": "\\S"
          },
          "coverage": {
            "properties": {
              "universe": {
                "pattern": "\\S"
              },
              "gaps": {
                "items": {
                  "pattern": "\\S"
                }
              }
            }
          },
          "freshness": {
            "$ref": "#/$defs/freshness_v1_1"
          },
          "sources": {
            "items": {
              "$ref": "#/$defs/source_v1_1"
            }
          },
          "artifact": {
            "$ref": "#/$defs/artifact_v1_1"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "complete"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "coverage": {
            "properties": {
              "gaps": {
                "maxItems": 0
              }
            }
          },
          "freshness": {
            "properties": {
              "status": {
                "const": "fresh"
              }
            }
          },
          "artifact": {
            "properties": {
              "status": {
                "const": "persisted"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "1.1.0"
          },
          "status": {
            "const": "complete"
          }
        },
        "required": [
          "schema_version",
          "status"
        ]
      },
      "then": {
        "properties": {
          "coverage": {
            "properties": {
              "expected": {
                "minimum": 1
              },
              "observed": {
                "minimum": 1
              },
              "percent": {
                "const": 100
              }
            }
          },
          "gate_inputs": {
            "properties": {
              "reliable_product": {
                "const": true
              },
              "denominator_known": {
                "const": true
              },
              "required_period_lag_known": {
                "const": true
              },
              "required_period_lag": {
                "const": 0
              },
              "gap_count": {
                "const": 0
              },
              "required_reviews_complete": {
                "const": true
              },
              "source_roles": {
                "items": {
                  "properties": {
                    "state": {
                      "enum": [
                        "available",
                        "equivalent_fallback"
                      ]
                    }
                  }
                }
              }
            }
          },
          "quality_flags": {
            "not": {
              "contains": {
                "enum": [
                  "COVERAGE_DENOMINATOR_UNKNOWN",
                  "DURABLE_PERSISTENCE_FAILED",
                  "DURABLE_PERSISTENCE_NOT_ATTEMPTED",
                  "EMPTY_ELIGIBLE_UNIVERSE",
                  "FRESHNESS_STALE",
                  "FRESHNESS_UNKNOWN",
                  "INCOMPLETE_COVERAGE",
                  "NON_EQUIVALENT_FALLBACK",
                  "NO_RELIABLE_DECISION_PRODUCT",
                  "REQUIRED_PERIOD_LAG",
                  "REQUIRED_PERIOD_UNKNOWN",
                  "REQUIRED_REVIEWS_INCOMPLETE",
                  "REQUIRED_SOURCE_STALE",
                  "REQUIRED_SOURCE_UNAVAILABLE"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
